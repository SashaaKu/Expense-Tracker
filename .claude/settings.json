{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
